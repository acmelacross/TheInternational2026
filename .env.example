# 服务端口
PORT=17826

# 持久化运行数据：部署/更新代码时不删除
DATA_DIR=/var/lib/ti2026-guide
TEAM_INTEL_TTL_SECONDS=21600
OPENDOTA_API_KEY=
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_TI_LEAGUE_ID=19719
OPENDOTA_DETAIL_MATCHES=6

# Liquipedia LPDB v3
LIQUIPEDIA_API_KEY=
CONTACT_EMAIL=
LIVE_REFRESH_INTERVAL_SECONDS=120
# 自动刷新每次只轮询部分来源；默认每 120 秒一轮
SOURCE_ROTATION_INTERVAL_SECONDS=120
# 每 30 分钟错峰刷新全部来源，用于完整复核
FULL_RECONCILE_INTERVAL_SECONDS=1800
# 全源刷新时各来源之间错开 350ms，降低突发请求
FULL_REFRESH_STAGGER_MS=350
MANUAL_REFRESH_COOLDOWN_SECONDS=60
SCHEDULE_SOURCE_TTL_SECONDS=300
XGOAT_SCHEDULE_API=https://ti.xgoat.top/api/schedule/wiki?year=2026
XGOAT_SCHEDULE_PAGE=https://ti.xgoat.top/schedule
GAME_DETAIL_TTL_SECONDS=300
PUBLIC_FALLBACK_ENABLED=true
APP_NAME=TI2026-Viewing-Guide

# ===============================
# 比赛详情页：多模型分析
# 真实 Key 只填服务器 .env，禁止提交 GitHub
# ===============================

# 阿里云百炼 / Qwen3.8-Max
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方 API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Moonshot / Kimi K3
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1

# 火山方舟 / Doubao-Seed-2.1-Pro
# 当前按平台实际可用模型 ID 配置；如后续模型版本变化，请覆盖 DOUBAO_MODEL
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 百度千帆 / ERNIE 5.1
ERNIE_API_KEY=
ERNIE_MODEL=ernie-5.1
ERNIE_BASE_URL=https://qianfan.baidubce.com/v2

# 腾讯云 TokenHub / Hy3
HY3_API_KEY=
HY3_MODEL=hy3
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
