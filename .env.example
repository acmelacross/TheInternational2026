# 服务端口
PORT=17826

# Liquipedia LPDB v3
LIQUIPEDIA_API_KEY=
CONTACT_EMAIL=
CACHE_TTL_SECONDS=300
GAME_DETAIL_TTL_SECONDS=300
PUBLIC_FALLBACK_ENABLED=true
APP_NAME=TI2026-Viewing-Guide

# ===============================
# 比赛详情页：多模型分析
# 真实 Key 只填服务器 .env，禁止提交 GitHub
# ===============================

# 阿里云百炼 / Qwen3.8-Max
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方 API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Moonshot / Kimi K3
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 火山方舟 / Doubao-Seed-2.1-Pro
# 当前按平台实际可用模型 ID 配置；如后续模型版本变化，请覆盖 DOUBAO_MODEL
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 百度千帆 / ERNIE 5.1
ERNIE_API_KEY=
ERNIE_MODEL=ernie-5.1
ERNIE_BASE_URL=https://qianfan.baidubce.com/v2

# 腾讯云 TokenHub / Hy3
HY3_API_KEY=
HY3_MODEL=hy3
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
