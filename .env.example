# 服务端口
PORT=17826

# Liquipedia LPDB v3 API Key（申请后填在这里）
LIQUIPEDIA_API_KEY=

# 建议填写你的联系邮箱，作为 User-Agent 标识的一部分
CONTACT_EMAIL=

# Liquipedia / 数据缓存时间，至少 60 秒；推荐 300 秒或更高
CACHE_TTL_SECONDS=300

# 单局 BP/KDA 详情缓存（秒）
GAME_DETAIL_TTL_SECONDS=300

# 无 Key 或 Liquipedia 暂不可用时，是否启用公共赛程降级源
PUBLIC_FALLBACK_ENABLED=true

APP_NAME=TI2026-Viewing-Guide
